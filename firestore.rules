rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function eventExists(eventId) {
      return eventId is string
        && exists(/databases/$(database)/documents/events/$(eventId));
    }

    function participantBelongsToEvent(participantId, eventId) {
      return get(/databases/$(database)/documents/participants/$(participantId)).data.eventId == eventId;
    }

    function participantBelongsToEventAfterCommit(participantId, eventId) {
      return getAfter(/databases/$(database)/documents/participants/$(participantId)).data.eventId == eventId;
    }

    // イベント方式(flow)。flow未設定/null/空/'legacy'は従来方式。'confirmed'(新方式)や未知の値は
    // 従来方式ではない。従来のクライアント直書き経路(設定更新・参加者作成/更新・旧受付)は
    // 従来方式のイベントだけに許可し、新方式のデータを旧経路から書き換えさせない。
    function isLegacyEventData(data) {
      return !('flow' in data) || data.flow == null || data.flow == '' || data.flow == 'legacy';
    }

    function eventIsLegacy(eventId) {
      return eventId is string
        && (!exists(/databases/$(database)/documents/events/$(eventId))
          || isLegacyEventData(get(/databases/$(database)/documents/events/$(eventId)).data));
    }

    // read専用(Phase 10B): 「参照先のイベントが存在し、かつlegacyと明確に判定できる」場合だけtrue。
    // 上の eventIsLegacy(write用)は「イベントが存在しない」場合もtrueにするが、readではそれを使わない
    // (イベントが存在しない=孤児データを、flowが無いのでlegacyとして公開してはならない)。
    // confirmed・未知のflow・eventIdが文字列でない/パスを壊す文字を含む・イベントが存在しない場合は、すべてfalse(fail-closed)。
    // Rulesはクエリ結果のフィルタではない。listでも resource.data.eventId が「クエリの条件から確定している」場合だけ評価が通り、
    // 確定できないクエリ(絞り込みなし・inで複数イベント混在 等)は、この関数が評価できず拒否される。
    function eventIsReadableLegacy(eventId) {
      return eventId is string
        && !eventId.matches('.*/.*')
        && exists(/databases/$(database)/documents/events/$(eventId))
        && isLegacyEventData(get(/databases/$(database)/documents/events/$(eventId)).data);
    }

    // TEST OPERATION ONLY: 本番管理者認証導入までは管理画面検証用にreadを許可。
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.eventId == eventId
        && isLegacyEventData(request.resource.data);
      allow update: if resource.data.eventId == eventId
        && request.resource.data.eventId == eventId
        && isLegacyEventData(resource.data)
        && isLegacyEventData(request.resource.data);
      allow delete: if false;
    }

    // Phase 10B: confirmed(新方式)の参加者(氏名・かな・メール・publicId・sourceReference等)は、未認証・認証済みを問わず
    // クライアントSDKから直接取得できない(get・list/queryとも拒否)。documentごと拒否する(フィールド単位の制御はしない)。
    // legacyのイベントの参加者だけ、従来どおりreadを許可する(旧マイページ・旧受付・旧管理画面の互換のため。Phase 10Cで認証境界へ移行)。
    // 存在しないイベント・未知のflow・eventId欠落の参加者も拒否する。confirmedの参加者情報は、Admin SDK経由のcallableだけが返す。
    match /participants/{participantId} {
      allow get, list: if eventIsReadableLegacy(resource.data.eventId);
      allow create: if request.resource.data.participantId == participantId
        && eventExists(request.resource.data.eventId)
        && request.resource.data.publicId is string
        && request.resource.data.publicId.size() >= 24
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.registeredCount is int
        && request.resource.data.registeredCount >= 1
        && request.resource.data.registrationType == 'preRegistered'
        && eventIsLegacy(request.resource.data.eventId);
      allow update: if request.resource.data.eventId == resource.data.eventId
        && eventIsLegacy(resource.data.eventId)
        && request.resource.data.participantId == resource.data.participantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participationConfirmed', 'participationConfirmedAt',
          'reconfirmed', 'reconfirmedAt', 'attendanceResponse', 'updatedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['attendanceResponse'])
          || request.resource.data.attendanceResponse in [
            'attending', 'notAttending'
          ]);
      allow delete: if false;
    }

    // Phase 10B: checkInsはlegacy専用(confirmedの受付の正本は programAttendances)。confirmed・未知のflow・孤児・eventId欠落は
    // readを拒否する。legacyのイベントの受付状態だけ、従来どおりreadを許可する。
    match /checkIns/{participantId} {
      allow get, list: if eventIsReadableLegacy(resource.data.eventId);
      allow create: if eventExists(request.resource.data.eventId)
        && eventIsLegacy(request.resource.data.eventId)
        && request.resource.data.participantId == participantId
        && participantBelongsToEventAfterCommit(participantId, request.resource.data.eventId);
      allow update: if request.resource.data.eventId == resource.data.eventId
        && eventIsLegacy(resource.data.eventId)
        && request.resource.data.participantId == participantId
        && participantBelongsToEvent(participantId, resource.data.eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'checkedIn', 'registeredCountSnapshot', 'attendedCount',
          'checkedInAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /mailLogs/{documentId} {
      allow read, write: if false;
    }

    match /mailJobs/{jobId} {
      allow get, list: if resource.data.eventId is string;
      allow create, update, delete: if false;

      match /items/{participantId} {
        allow read, write: if false;
      }
    }

    // 権限の正本(Firebase Auth UID → accessRoles/{uid})。クライアントSDKからはread/writeとも一切許可しない
    // (admin自身も、自分のroleを読めず、書き換えられない)。読み書きはAdmin SDK(Functions・ブートストラップCLI)だけ。
    // 権限の確認はcallable(getMyAccessRole)経由。ここに allow を追加してはならない。
    match /accessRoles/{uid} {
      allow read, write: if false;
    }

    // 新方式の当選者CSV取込の記録(取込回と、その全行の監査)。クライアントからのread/writeは一切許可しない。
    // 読み書きはAdmin SDK(admin専用callable)だけ。監査行には個人情報を持たない。
    match /importBatches/{batchId} {
      allow read, write: if false;

      match /rows/{rowId} {
        allow read, write: if false;
      }
    }

    // 新方式の当選メールの送信ジョブと配送記録。クライアントからのread/writeは一切許可しない(Admin SDK・admin専用callableのみ)。
    // mailDeliveriesは「参加者へメールを送ったか」の正本。旧mailJobsは使わない(旧processorに誤処理されないため)。
    // 当選メールのテンプレート(events.winnerMailTemplate)も、confirmedイベントはクライアントから更新できない
    // (events の更新はlegacyイベントだけに許可しているため)。更新は必ずadmin専用callable経由。
    match /sendJobs/{jobId} {
      allow read, write: if false;

      match /items/{participantId} {
        allow read, write: if false;
      }
    }

    match /mailDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    // 新方式(flow=confirmed)のparticipant×program。クライアントからの直接read/writeは許可しない。
    // 書込みはFunctions(Admin SDK)経由のみ。許可(allow)を追加する場合は先にセキュリティ設計を行うこと。
    // 受付(checkedIn・checkedInAt・attendedCount・checkedInBy)の正本。受付はcallable(checkInConfirmedProgram、staff/adminのみ)経由。
    // 受付履歴(history)も同じく直接read/write禁止。
    match /programAttendances/{attendanceId} {
      allow read, write: if false;

      match /history/{historyId} {
        allow read, write: if false;
      }
    }

    match /walkInRegistrations/{registrationId} {
      allow read, write: if false;
    }
  }
}
