rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 10C: 従来方式(legacy)のクライアントSDK直接read/writeを閉じた。
    // これまで旧管理画面・旧マイページ・旧受付が、events・participants・checkIns・mailJobs を直接読み書き・購読していたが、
    // すべて認証つきのサーバーAPI(admin/staffOrAdmin)または参加者capability(participantId+publicId)のcallableへ移した。
    // Admin SDKはRulesの影響を受けない(Functionsの従来Scheduler・callableは変わらず動く)。
    //
    // 【残しているread(Phase 10Dで閉じる予定)】
    //   events の read だけは公開のまま(受付QR /reception が、従来方式か新方式かを判定するためにイベントを1件読む)。
    //   eventsには参加者の個人情報を持たないが、イベント名・会場・日時・(confirmedの)テンプレート等を誰でも読める。
    //   Phase 10Dで、方式判定を認証つきAPIへ移してから閉じること。
    // 【writeはすべて閉じた】eventsのcreate/update/delete、participants・checkInsの全操作、mailJobsの全操作。
    //   イベントの作成・更新・参加者登録・受付・削除・一括メールは、すべてサーバーAPI経由(サーバーが認可・legacy判定・入力検証・transactionを行う)。
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Phase 10C: participants(氏名・かな・メール・publicId等)は、未認証・認証済みを問わずクライアントSDKから
    // 直接get/list/create/update/deleteできない。従来方式の参加者もconfirmedの参加者も同じ(参照先イベントの有無・flowに依存しない。
    // 存在しないイベントの孤児・未知のflow・eventId欠落・型が不正なデータも、読み書きとも拒否される)。
    // 読み書きはAdmin SDKだけ(admin/staff/参加者capabilityのcallable)。
    match /participants/{participantId} {
      allow read, write: if false;
    }

    // Phase 10C: checkIns(従来方式の受付状態)も、クライアントSDKからの直接read/writeを全面拒否する。
    // confirmedの受付の正本は programAttendances(下記)。受付はstaff/adminのcallable経由。
    match /checkIns/{participantId} {
      allow read, write: if false;
    }

    match /mailLogs/{documentId} {
      allow read, write: if false;
    }

    // Phase 10C: 従来の一括メールジョブ。進捗の表示は管理者向けAPI(getLegacyEventAdminView)へ移したため、readも閉じた。
    match /mailJobs/{jobId} {
      allow read, write: if false;

      match /items/{participantId} {
        allow read, write: if false;
      }
    }

    // 権限の正本(Firebase Auth UID → accessRoles/{uid})。クライアントSDKからはread/writeとも一切許可しない
    // (admin自身も、自分のroleを読めず、書き換えられない)。読み書きはAdmin SDK(Functions・ブートストラップCLI)だけ。
    // 権限の確認はcallable(getMyAccessRole)経由。ここに allow を追加してはならない。
    match /accessRoles/{uid} {
      allow read, write: if false;
    }

    // 新方式の当選者CSV取込の記録(取込回と、その全行の監査)。クライアントからのread/writeは一切許可しない。
    // 読み書きはAdmin SDK(admin専用callable)だけ。監査行には個人情報を持たない。
    match /importBatches/{batchId} {
      allow read, write: if false;

      match /rows/{rowId} {
        allow read, write: if false;
      }
    }

    // 新方式の当選メールの送信ジョブと配送記録。クライアントからのread/writeは一切許可しない(Admin SDK・admin専用callableのみ)。
    // mailDeliveriesは「参加者へメールを送ったか」の正本。旧mailJobsは使わない(旧processorに誤処理されないため)。
    // 当選メールのテンプレート(events.winnerMailTemplate)も、confirmedイベントはクライアントから更新できない
    // (Phase 10Cで events の書込みは全面拒否した)。更新は必ずadmin専用callable経由。
    match /sendJobs/{jobId} {
      allow read, write: if false;

      match /items/{participantId} {
        allow read, write: if false;
      }
    }

    match /mailDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    // 新方式(flow=confirmed)のparticipant×program。クライアントからの直接read/writeは許可しない。
    // 書込みはFunctions(Admin SDK)経由のみ。許可(allow)を追加する場合は先にセキュリティ設計を行うこと。
    // 受付(checkedIn・checkedInAt・attendedCount・checkedInBy)の正本。受付はcallable(checkInConfirmedProgram、staff/adminのみ)経由。
    // 受付履歴(history)も同じく直接read/write禁止。
    match /programAttendances/{attendanceId} {
      allow read, write: if false;

      match /history/{historyId} {
        allow read, write: if false;
      }
    }

    match /walkInRegistrations/{registrationId} {
      allow read, write: if false;
    }
  }
}
